{
  "name": "@erp/mobile",
  "version": "0.0.1",
  "description": "ERP Mobile Application (React Native)",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "node ../../node_modules/expo/bin/cli start",
    "android": "node ../../node_modules/expo/bin/cli run:android",
    "ios": "node ../../node_modules/expo/bin/cli run:ios",
    "web": "node ../../node_modules/expo/bin/cli start --web",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest",
    "config": "node ../../node_modules/expo/bin/cli config --type public"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/vector-icons": "14.0.2",
    "@react-native/assets-registry": "0.73.1",
    "@tanstack/react-query": "^5.0.0",
    "expo": "^50.0.0",
    "expo-asset": "9.0.2",
    "expo-clipboard": "~5.0.1",
    "expo-constants": "15.4.6",
    "expo-image": "1.10.6",
    "expo-linking": "6.2.2",
    "expo-modules-core": "1.11.14",
    "expo-router": "~3.4.10",
    "expo-secure-store": "~12.8.1",
    "expo-status-bar": "1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
