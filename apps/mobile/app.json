{
  "expo": {
    "name": "ERP-SC",
    "slug": "erp-sc",
    "scheme": "erp-sc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-release-signing.cjs"
    ],
    "android": {
      "package": "com.erpsc.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "backgroundColor": "#FFFFFF",
        "resizeMode": "contain"
      },
      "allowBackup": false
    },
    "extra": {
      "apiBaseUrl": "https://erp-sc-api.onrender.com/api/v1"
    }
  }
}
