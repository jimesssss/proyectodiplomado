{
  "name": "@erp/api",
  "version": "0.0.1",
  "description": "ERP Backend API",
  "type": "module",
  "main": "dist/apps/api/src/index.js",
  "types": "dist/apps/api/src/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../../node_modules/typescript/bin/tsc --noCheck",
    "start": "node dist/apps/api/src/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@erp/permissions": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.0",
    "pino": "^8.17.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
