{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../vitest.config.ts",
    "../apps/*/src/**/*.ts",
    "../packages/*/src/**/*.ts"
  ],
  "exclude": ["../node_modules", "**/dist/**"]
}
