{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@erp/types": ["packages/types/src"],
      "@erp/types/*": ["packages/types/src/*"],
      "@erp/shared-types": ["packages/shared-types/src"],
      "@erp/shared-types/*": ["packages/shared-types/src/*"],
      "@erp/validation": ["packages/validation/src"],
      "@erp/validation/*": ["packages/validation/src/*"],
      "@erp/ui": ["packages/ui/src"],
      "@erp/ui/*": ["packages/ui/src/*"],
      "@erp/api-client": ["packages/api-client/src"],
      "@erp/api-client/*": ["packages/api-client/src/*"],
      "@erp/permissions": ["packages/permissions/src"],
      "@erp/permissions/*": ["packages/permissions/src/*"],
      "@erp/config": ["packages/config/src"],
      "@erp/config/*": ["packages/config/src/*"],
      "@erp/utils": ["packages/utils/src"],
      "@erp/utils/*": ["packages/utils/src/*"]
    }
  }
}
