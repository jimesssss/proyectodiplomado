# Copy to .env and replace unused values with your local settings.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/erp-dev?retryWrites=true&w=majority

# Auth / JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API behavior
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
LOG_LEVEL=debug
API_DOCS_ENABLED=true
API_DOCS_PATH=/api/docs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
TIMEZONE=America/Argentina/Buenos_Aires

# Optional future infra
REDIS_URL=redis://localhost:6379

# Public client variables
API_BASE_URL=http://localhost:4000/api/v1
WEB_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# Production placeholders only
# NODE_ENV=production
# PORT=10000
# API_BASE_URL=https://your-render-api.onrender.com/api/v1
# CORS_ORIGINS=https://your-web-domain.example.com
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/erp-prod
