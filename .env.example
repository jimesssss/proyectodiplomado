# Environment example file
# Copy this file to .env and replace the placeholder values with your local settings.
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/erp-dev?retryWrites=true&w=majority

# Security - JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Logging
LOG_LEVEL=debug

# Redis (for future use - caching, sessions, events)
REDIS_URL=redis://localhost:6379

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api/docs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Business Logic
TIMEZONE=America/Argentina/Buenos_Aires
