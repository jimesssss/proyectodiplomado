# Copiar a .env (nunca commitear .env real)
NODE_ENV=development
PORT=4000

# MongoDB Atlas (FASE 2)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/erp?retryWrites=true&w=majority

# Auth (FASE 3) — RS256
JWT_ISSUER=erp
JWT_AUDIENCE=erp-api
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Object Storage (archivos, fase posterior)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
